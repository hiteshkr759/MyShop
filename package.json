{
  "name": "myshop",
  "version": "1.0.0",
  "description": "E-Commerce backend API for MyShop built with Node.js and Express",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/enforce-antigravity-lock.js",
    "predev": "node scripts/enforce-antigravity-lock.js",
    "prebuild": "node scripts/enforce-antigravity-lock.js",
    "build": "node scripts/enforce-antigravity-lock.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "db:test": "node scripts/test-connection.js",
    "lint": "eslint src/",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs myshop-api",
    "pm2:status": "pm2 status",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "myshop",
    "ecommerce",
    "nodejs",
    "express",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/sensible": "^6.0.7",
    "@prisma/client": "^6.4.1",
    "@supabase/supabase-js": "^2.117.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "morgan": "^1.10.0",
    "pm2": "^7.0.4"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "nodemon": "^3.1.9",
    "prisma": "^6.4.1",
    "typescript": "^5.7.3"
  }
}
