{
  "name": "myshop",
  "version": "1.0.0",
  "description": "E-Commerce backend API for MyShop built with Node.js and Fastify",
  "main": "src/server.js",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "preinstall": "node scripts/enforce-antigravity-lock.js",
    "postinstall": "prisma generate",
    "build": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "db:test": "node scripts/test-connection.js",
    "lint": "eslint src/",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs myshop-api",
    "pm2:status": "pm2 status",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "myshop",
    "ecommerce",
    "nodejs",
    "fastify",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/sensible": "^6.0.1",
    "@fastify/static": "^8.1.0",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^5.0.1",
    "@prisma/client": "^6.4.1",
    "@supabase/supabase-js": "^2.39.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.3.2",
    "fastify-plugin": "^5.0.1"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "nodemon": "^3.1.9",
    "prisma": "^6.4.1",
    "typescript": "^5.7.3"
  }
}